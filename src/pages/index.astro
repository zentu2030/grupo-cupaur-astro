---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Inicio">
  <Header />

  <main>
    <!-- HERO SECTION -->
    <section class="hero">
      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span> ESPECIALISTAS EN MINERÍA PERUANA
          </div>
          <h1 class="hero-title">
            LÍDERES EN <span class="text-primary">INGENIERÍA</span><br />
            <span class="text-primary">ELECTROMECÁNICA Y</span><br />
            <span class="text-primary">CONSTRUCCIÓN</span> DE<br />
            ALTA PRECISIÓN
          </h1>
          <p class="hero-text">
            En Grupo Cupaur, transformamos la eficiencia industrial mediante
            servicios especializados de ingeniería electromecánica y
            construcción. Brindamos seguridad y eficiencia con fuerza industrial
            para sus operaciones mineras.
          </p>
          <div class="hero-buttons">
            <a href="#servicios" class="btn btn-primary btn-glow"
              >NUESTROS SERVICIOS <span>→</span></a
            >
            <a href="/contacto" class="btn btn-outline-cyan"
              >SOLICITAR COTIZACIÓN</a
            >
          </div>
        </div>
        <div class="hero-image-wrapper">
          <img
            src="/imagenes/ingeneria_electromecanica_y_construccion_1.webp"
            alt="Ingeniería electromecánica"
            class="hero-image"
            width="600"
            height="400"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- SERVICIOS SECTION -->
    <section id="servicios" class="section bg-light">
      <div class="container">
        <div class="section-header text-center">
          <span class="badge"
            ><span class="badge-dot"></span> NUESTROS SERVICIOS</span
          >
          <h2>
            SERVICIOS INTEGRALES DE <span class="text-primary"
              >INGENIERÍA ELECTROMECÁNICA Y CONSTRUCCIÓN</span
            >
          </h2>
          <p class="section-desc">
            Soluciones a medida para optimizar sus operaciones, enfocados en
            calidad, seguridad y eficiencia. Su proyecto en manos de expertos.
          </p>
        </div>

        <div class="services-grid">
          <!-- Card 1 -->
          <div class="service-card">
            <div class="service-img">
              <img
                src="/imagenes/ingeneria_electromecanica_y_construccion_1.webp"
                alt="Servicios y Proyectos Eléctricos"
                width="400"
                height="200"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="service-content">
              <h3>SERVICIOS Y PROYECTOS ELÉCTRICOS</h3>
              <p>
                Diseño e implementación de sistemas eléctricos industriales de
                alta complejidad con estándares internacionales.
              </p>
              <a href="/servicios" class="service-link"
                >MÁS INFORMACIÓN <span class="arrow">→</span></a
              >
            </div>
          </div>
          <!-- Card 2 -->
          <div class="service-card">
            <div class="service-img">
              <img
                src="/imagenes/ingeneria_electromecanica_y_construccion_2.webp"
                alt="Mantenimientos Eléctricos"
                width="400"
                height="200"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="service-content">
              <h3>MANTENIMIENTOS ELÉCTRICOS</h3>
              <p>
                Programas preventivos y correctivos para asegurar la continuidad
                operativa de su planta.
              </p>
              <a href="/servicios" class="service-link"
                >MÁS INFORMACIÓN <span class="arrow">→</span></a
              >
            </div>
          </div>
          <!-- Card 3 -->
          <div class="service-card">
            <div class="service-img">
              <img
                src="/imagenes/ingeneria_electromecanica_y_construccion_3.webp"
                alt="Proyectos Eléctricos Instrumentales"
                width="400"
                height="200"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="service-content">
              <h3>PROYECTOS ELÉCTRICOS INSTRUMENTALES</h3>
              <p>
                Automatización y control de procesos para maximizar la
                productividad y seguridad.
              </p>
              <a href="/servicios" class="service-link"
                >MÁS INFORMACIÓN <span class="arrow">→</span></a
              >
            </div>
          </div>
          <!-- Card 4 -->
          <div class="service-card">
            <div class="service-img">
              <img
                src="/imagenes/ingeneria_electromecanica_y_construccion_4.webp"
                alt="Obras Hidráulicas"
                width="400"
                height="200"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="service-content">
              <h3>OBRAS HIDRÁULICAS</h3>
              <p>
                Construcción de sistemas de bombeo, redes de tuberías y
                tratamiento de aguas.
              </p>
              <a href="/servicios" class="service-link"
                >MÁS INFORMACIÓN <span class="arrow">→</span></a
              >
            </div>
          </div>
          <!-- Card 5 -->
          <div class="service-card">
            <div class="service-img">
              <img
                src="/imagenes/ingeneria_electromecanica_y_construccion_5.webp"
                alt="Mantenimiento de Relaves"
                width="400"
                height="200"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="service-content">
              <h3>MANTENIMIENTO DE RELAVES</h3>
              <p>
                Gestión integral y mantenimiento de depósitos de relaves mineros
                con alto estándar ambiental.
              </p>
              <a href="/servicios" class="service-link"
                >MÁS INFORMACIÓN <span class="arrow">→</span></a
              >
            </div>
          </div>
          <!-- Card 6 -->
          <div class="service-card">
            <div class="service-img">
              <img
                src="/imagenes/ingeneria_electromecanica_y_construccion_1.webp"
                alt="Estructuras Mecánicas"
                width="400"
                height="200"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="service-content">
              <h3>ESTRUCTURAS MECÁNICAS</h3>
              <p>
                Fabricación y montaje de estructuras pesadas para el sector
                minero e industrial.
              </p>
              <a href="/servicios" class="service-link"
                >MÁS INFORMACIÓN <span class="arrow">→</span></a
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- EXCELENCIA SECTION -->
    <section class="section excellence bg-secondary">
      <div class="container excellence-container">
        <div class="excellence-img-wrapper">
          <img
            src="/imagenes/grupo_cupaur_4.webp"
            alt="Excelencia Industrial"
            class="excellence-img"
            width="600"
            height="450"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="excellence-content">
          <span class="badge outline"
            ><span class="badge-dot"></span> ¿POR QUÉ GRUPO CUPAUR?</span
          >
          <h2 class="text-white">
            COMPROMETIDOS CON LA <span class="text-primary">EXCELENCIA</span> INDUSTRIAL
          </h2>
          <p class="text-light-gray">
            Más de una década brindando soluciones electromecánicas y de
            construcción para el sector minero, superando los más altos
            estándares de calidad y seguridad.
          </p>

          <div class="features-grid">
            <div class="feature-box">
              <h3>SEGURIDAD TOTAL</h3>
              <p>
                Cero incidentes como prioridad en todas nuestras operaciones en
                campo.
              </p>
            </div>
            <div class="feature-box">
              <h3>ALTA EFICIENCIA</h3>
              <p>Procesos optimizados para cumplir plazos y presupuestos.</p>
            </div>
            <div class="feature-box">
              <h3>EQUIPO EXPERTO</h3>
              <p>Profesionales altamente capacitados y certificados.</p>
            </div>
            <div class="feature-box">
              <h3>SOCIO ESTRATÉGICO</h3>
              <p>Acompañamiento continuo desde el diseño hasta la ejecución.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTORES SECTION -->
    <section class="section bg-white">
      <div class="container">
        <div class="section-header text-center">
          <span class="badge"
            ><span class="badge-dot"></span> PRESENCIA EN LA INDUSTRIA</span
          >
          <h2>
            SECTORES ESTRATÉGICOS DONDE APLICAMOS NUESTRA <span
              class="text-primary">INGENIERÍA</span
            >
          </h2>
          <p class="section-desc">
            Presencia consolidada en las principales operaciones mineras e
            industriales, adaptándonos a los entornos más exigentes.
          </p>
        </div>

        <div class="sectors-grid">
          <div class="sector-card">
            <img
              src="/imagenes/grupo_cupaur_5.webp"
              alt="Gran Minería & Tajo Abierto"
              width="600"
              height="300"
              loading="lazy"
              decoding="async"
            />
            <div class="sector-overlay">
              <h3>GRAN MINERÍA & TAJO ABIERTO</h3>
            </div>
          </div>
          <div class="sector-card">
            <img
              src="/imagenes/grupo_cupaur_6.webp"
              alt="Minería Subterránea"
              width="300"
              height="300"
              loading="lazy"
              decoding="async"
            />
            <div class="sector-overlay">
              <h3>MINERÍA SUBTERRÁNEA</h3>
            </div>
          </div>
          <div class="sector-card">
            <img
              src="/imagenes/grupo_cupaur_7.webp"
              alt="Plantas Concentradoras"
              width="300"
              height="300"
              loading="lazy"
              decoding="async"
            />
            <div class="sector-overlay">
              <h3>PLANTAS CONCENTRADORAS</h3>
            </div>
          </div>
          <div class="sector-card">
            <img
              src="/imagenes/grupo_cupaur_8.webp"
              alt="Fundición & Metalurgia"
              width="300"
              height="300"
              loading="lazy"
              decoding="async"
            />
            <div class="sector-overlay">
              <h3>FUNDICIÓN & METALURGIA</h3>
            </div>
          </div>
          <div class="sector-card">
            <img
              src="/imagenes/grupo_cupaur_9.webp"
              alt="Construcción Industrial"
              width="300"
              height="300"
              loading="lazy"
              decoding="async"
            />
            <div class="sector-overlay">
              <h3>CONSTRUCCIÓN INDUSTRIAL</h3>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- COMO TRABAJAMOS -->
    <section class="section bg-secondary text-white">
      <div class="container">
        <div class="section-header text-center">
          <span class="badge outline"
            ><span class="badge-dot"></span> METODOLOGÍA DE POTENCIA</span
          >
          <h2 class="text-white">
            CÓMO <span class="text-primary">TRABAJAMOS</span>
          </h2>
          <p class="section-desc text-light-gray">
            Metodología comprobada que garantiza resultados excepcionales en
            cada proyecto, de inicio a fin.
          </p>
        </div>

        <div class="process-grid">
          <div class="process-step">
            <div class="step-number">01</div>
            <h3>DIAGNÓSTICO TÉCNICO</h3>
            <p>
              Evaluación exhaustiva de necesidades y condiciones operativas para
              definir la mejor estrategia.
            </p>
          </div>
          <div class="process-step">
            <div class="step-number">02</div>
            <h3>INGENIERÍA EN DETALLE</h3>
            <p>
              Desarrollo de planos, cálculos y especificaciones con herramientas
              tecnológicas de vanguardia.
            </p>
          </div>
          <div class="process-step">
            <div class="step-number">03</div>
            <h3>EJECUCIÓN SUPERIOR</h3>
            <p>
              Implementación en campo con estrictos controles de calidad,
              seguridad y cumplimiento de cronogramas.
            </p>
          </div>
          <div class="process-step">
            <div class="step-number">04</div>
            <h3>ENTREGA AL CLIENTE</h3>
            <p>
              Pruebas, puesta en marcha y documentación técnica completa
              garantizando la satisfacción total.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-section">
      <div class="container cta-container">
        <div class="cta-box">
          <h2>
            ¿LISTO PARA OPTIMIZAR SU <span class="text-primary"
              >OPERACIÓN MINERA</span
            >?
          </h2>
          <p>
            Nuestro equipo de ingenieros especializados está listo para analizar
            sus requerimientos<br />y presentarle una propuesta de alto
            rendimiento.
          </p>
          <div class="cta-buttons">
            <a href="/contacto" class="btn btn-primary btn-cta"
              >SOLICITAR COTIZACIÓN TÉCNICA <span>→</span></a
            >
            <a
              href="https://wa.me/51937441668"
              class="btn btn-outline outline-light btn-cta"
              >HABLAR POR WHATSAPP</a
            >
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Local Styles */
  .text-center {
    text-align: center;
  }
  .text-white {
    color: var(--color-white) !important;
  }
  .text-light-gray {
    color: #a0aabf;
  }
  .bg-light {
    background-color: var(--color-light);
  }
  .bg-white {
    background-color: var(--color-white);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(0, 171, 227, 0.1);
    color: var(--color-primary);
    padding: 6px 16px;
    border-radius: 4px;
    border: 1px solid rgba(0, 171, 227, 0.2);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 15px;
  }
  .badge.outline {
    background-color: transparent;
    border: 1px solid rgba(0, 171, 227, 0.5);
  }

  .section-header {
    max-width: 800px;
    margin: 0 auto 50px;
  }
  .section-header h2 {
    font-size: 2.5rem;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .section-desc {
    color: var(--color-text-light);
    font-size: 1.1rem;
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 140px 0 100px;
    background-color: var(--color-secondary);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .hero-content {
    max-width: 650px;
    color: var(--color-white);
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(0, 171, 227, 0.1);
    color: var(--color-primary);
    padding: 6px 16px;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 1px;
    margin-bottom: 25px;
    border: 1px solid rgba(0, 171, 227, 0.2);
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-primary);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(0, 171, 227, 0.8);
  }
  .hero-title {
    color: var(--color-white);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 25px;
    text-transform: uppercase;
  }
  .hero-title span.text-primary {
    color: var(--color-primary);
  }
  .hero-text {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 40px;
    color: #b0b8c8;
  }
  .hero-buttons {
    display: flex;
    gap: 20px;
  }
  .btn-glow {
    background-color: var(--color-primary);
    color: var(--color-secondary);
    box-shadow: 0 0 15px rgba(0, 171, 227, 0.5);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn-glow:hover {
    box-shadow: 0 0 25px rgba(0, 171, 227, 0.8);
    background-color: #00bfff;
  }
  .btn-outline-cyan {
    background-color: transparent;
    border: 1px solid rgba(0, 171, 227, 0.5);
    color: var(--color-primary);
    padding: 12px 24px;
    border-radius: 4px;
    font-family: var(--font-heading);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.875rem;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .btn-outline-cyan:hover {
    background-color: rgba(0, 171, 227, 0.1);
    border-color: var(--color-primary);
  }
  .hero-image-wrapper {
    position: relative;
    border: 1px solid rgba(0, 171, 227, 0.3);
    padding: 10px;
    background: rgba(17, 43, 82, 0.5);
  }
  .hero-image {
    width: 100%;
    height: auto;
    object-fit: cover;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    display: block;
  }

  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-content {
      margin: 0 auto;
    }
    .hero-buttons {
      justify-content: center;
    }
  }

  /* Services Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 30px;
  }
  .service-card {
    background: var(--color-white);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 171, 227, 0.15);
  }
  .service-img img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  .service-content {
    padding: 30px;
  }
  .service-content h3 {
    font-size: 1.25rem;
    margin-bottom: 15px;
    color: var(--color-secondary);
  }
  .service-content p {
    color: var(--color-text-light);
    margin-bottom: 20px;
    font-size: 0.95rem;
  }
  .service-link {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .service-link:hover .arrow {
    transform: translateX(5px);
  }
  .arrow {
    transition: transform 0.3s ease;
  }

  /* Excellence Section */
  .excellence-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
  }
  .excellence-img {
    border-radius: 8px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }
  .excellence-content h2 {
    font-size: 2.5rem;
    margin-bottom: 20px;
    margin-top: 15px;
  }
  .features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
    margin-top: 40px;
  }
  .feature-box {
    background: rgba(255, 255, 255, 0.05);
    padding: 25px;
    border-radius: 8px;
    border-left: 4px solid var(--color-primary);
  }
  .feature-box h3 {
    color: var(--color-white);
    margin-bottom: 10px;
    font-size: 1.1rem;
  }
  .feature-box p {
    color: #a0aabf;
    font-size: 0.9rem;
  }

  /* Sectors Grid */
  .sectors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 20px;
  }
  .sector-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    height: 300px;
  }
  .sector-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .sector-card:hover img {
    transform: scale(1.1);
  }
  .sector-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(17, 43, 82, 0.9) 0%,
      rgba(0, 0, 0, 0) 70%
    );
    display: flex;
    align-items: flex-end;
    padding: 20px;
  }
  .sector-overlay h3 {
    color: var(--color-white);
    font-size: 1.1rem;
    text-transform: uppercase;
  }
  .sectors-grid .sector-card:nth-child(1) {
    grid-column: span 2;
  }
  @media (max-width: 768px) {
    .sectors-grid .sector-card:nth-child(1) {
      grid-column: span 1;
    }
  }

  /* Process Grid */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    margin-top: 50px;
  }
  .process-step {
    background: rgba(255, 255, 255, 0.03);
    padding: 40px 30px;
    border-radius: 8px;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: transform 0.3s ease;
  }
  .process-step:hover {
    transform: translateY(-10px);
    border-color: rgba(0, 171, 227, 0.3);
  }
  .step-number {
    font-size: 4rem;
    font-weight: 800;
    color: rgba(0, 171, 227, 0.2);
    position: absolute;
    top: 20px;
    right: 20px;
    line-height: 1;
    font-family: var(--font-heading);
  }
  .process-step h3 {
    color: var(--color-white);
    font-size: 1.2rem;
    margin-top: 30px;
    margin-bottom: 15px;
    position: relative;
    z-index: 1;
  }
  .process-step p {
    color: #a0aabf;
    font-size: 0.95rem;
    position: relative;
    z-index: 1;
  }

  /* CTA Section */
  .cta-section {
    padding: 100px 0;
