---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto | Grupo Cupaur">
  <Header />

  <main>
    <!-- CONTACTO HERO -->
    <section class="contacto-hero" style="background-image: linear-gradient(rgba(11, 28, 54, 0.7), rgba(11, 28, 54, 0.7)), url('/imagenes/ingeneria_electromecanica_y_construccion_1.webp');">
      <div class="container contacto-hero-container">
        <span class="badge"><span class="badge-dot"></span> ATENCIÓN ESPECIALIZADA</span>
        <h1 class="title-800 text-white">HABLEMOS DE SU <span class="text-primary">PROYECTO</span></h1>
        <p class="contacto-subtitle text-light-gray">Nuestro equipo de ingenieros está preparado para atender sus consultas técnicas y enviarle una propuesta detallada ajustada a las necesidades operativas de su mina o planta.</p>
      </div>
    </section>

    <!-- CANALES DE ATENCIÓN -->
    <section class="section canales-section">
      <div class="container">
        <div class="canales-grid">
          <div class="canales-info">
            <h2 class="title-800 text-white">NUESTROS CANALES DE <span class="text-primary">ATENCIÓN</span></h2>
            <p class="text-light-gray mb-40">Para consultas operativas, requerimientos de mantenimiento, licitaciones o soporte de emergencias, comuníquese directamente a nuestras líneas corporativas.</p>

            <div class="contact-item">
              <div class="contact-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div class="contact-text">
                <h3>CENTRAL DE ATENCIÓN</h3>
                <p>937 441 668 / 945 119 310</p>
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div class="contact-text">
                <h3>CONSULTAS Y LICITACIONES</h3>
                <p>contacto@grupocupaur.com</p>
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div class="contact-text">
                <h3>SEDE PRINCIPAL</h3>
                <p>Arequipa, Perú | Operaciones a Nivel Nacional</p>
              </div>
            </div>

            <div class="contact-actions">
              <a href="https://wa.me/51937441668" target="_blank" class="btn btn-whatsapp">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.438 9.889-9.886.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.89 4.44-9.892 9.886-.001 2.125.593 3.456 1.574 5.111l-.973 3.548 3.653-.959zm10.733-7.5c-.242-.12-.43-.242-.811-.433s-.811-.433-.948-.5c-.136-.067-.235-.103-.335.05s-.386.483-.473.583c-.087.101-.174.113-.416-.007-.242-.12-1.018-.375-1.941-1.196-.718-.639-1.202-1.428-1.343-1.67s-.015-.373.105-.493c.108-.108.242-.282.362-.423s.161-.242.242-.403c.081-.161.041-.302-.02-.423s-.335-.811-.459-1.112c-.12-.292-.245-.252-.335-.257-.087-.005-.188-.005-.289-.005s-.262.038-.399.188c-.136.15-.522.51-.522 1.244 0 .734.534 1.444.608 1.544.073.101 1.052 1.606 2.548 2.251.356.154.634.245.851.314.358.114.684.098.941.06.286-.041.879-.359 1.002-.707.122-.348.122-.646.085-.707s-.136-.109-.378-.228z"/></svg>
                CONTACTAR VÍA WHATSAPP
              </a>
              <a href="mailto:contacto@grupocupaur.com" class="btn btn-outline-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                ENVIAR CORREO ELECTRÓNICO
              </a>
            </div>
          </div>
          <div class="canales-map-box" style="background-image: url('/imagenes/grupo_cupaur_9.webp');">
            <div class="map-overlay">
              <span class="badge"><span class="badge-dot"></span> OPERACIONES</span>
              <h3 class="title-800 text-white">PRESENCIA NACIONAL</h3>
              <p class="text-light-gray">Sede corporativa en Arequipa con capacidad técnica y logística para despliegue operativo a lo largo de todos los corredores mineros del Perú.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Contacto Hero */
  .contacto-hero {
    background-color: #0b1c36;
    background-size: cover;
    background-position: center;
    padding: 180px 0 120px;
    text-align: center;
  }
  .contacto-hero-container {
    max-width: 800px;
  }
  .contacto-hero h1 {
    font-size: 3.5rem;
    margin-bottom: 20px;
    text-transform: uppercase;
  }
  .contacto-subtitle {
    font-size: 1.1rem;
    max-width: 700px;
    margin: 0 auto;
  }

  /* Canales Section */
  .canales-section {
    background-color: #0b1c36;
    padding: 100px 0;
  }
  .canales-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .canales-info h2 {
    font-size: 2.5rem;
    margin-bottom: 20px;
    line-height: 1.2;
  }
  .mb-40 { margin-bottom: 40px; }

  .contact-item {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
    align-items: flex-start;
  }
  .contact-icon {
    background-color: rgba(0, 171, 227, 0.1);
    color: var(--color-primary);
    width: 50px;
    height: 50px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 8px;
    flex-shrink: 0;
    border: 1px solid rgba(0, 171, 227, 0.2);
  }
  .contact-text h3 {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 800;
    margin-bottom: 5px;
    letter-spacing: 1px;
  }
  .contact-text p {
    color: var(--color-white);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 50px;
  }
  .btn-whatsapp {
    background-color: #25D366;
    color: white;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 30px;
    border-radius: 4px;
    transition: all 0.3s ease;
  }
  .btn-whatsapp:hover {
    background-color: #128C7E;
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(37, 211, 102, 0.2);
  }

  .canales-map-box {
    position: relative;
    height: 500px;
    background-size: cover;
    background-position: center;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(0, 171, 227, 0.2);
    display: flex;
    align-items: flex-end;
    padding: 40px;
  }
  .map-overlay {
    background-color: rgba(11, 28, 54, 0.9);
    padding: 30px;
    border-radius: 8px;
    border-left: 4px solid var(--color-primary);
    max-width: 400px;
  }
  .map-overlay h3 {
    font-size: 1.5rem;
    margin-bottom: 15px;
  }

  /* Badge Styles */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: rgba(11, 28, 54, 0.5);
    color: var(--color-primary);
    padding: 8px 20px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 25px;
    border: 1px solid rgba(0, 171, 227, 0.4);
    backdrop-filter: blur(4px);
  }
  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-primary);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-primary);
  }

  .title-800 { font-weight: 800 !important; }
  .text-white { color: var(--color-white) !important; }
  .text-light-gray { color: #a0aabf !important; }
  .text-primary { color: var(--color-primary) !important; }

  /* Responsive */
  @media (max-width: 992px) {
    .canales-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    .canales-map-box {
      height: 400px;
    }
  }
  @media (max-width: 768px) {
    .contacto-hero h1 { font-size: 1.8rem; }
    .canales-info h2 { font-size: 1.6rem; }
    .title-800 { font-size: 1.6rem; }
  }
</style>
